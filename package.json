{
  "name": "ave-maria-beauty-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Ave Maria Beauty Lab — мультибрендовий магазин косметики. Next.js store.",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "build:fast": "next build --turbopack",
    "start": "next start -p 3001",
    "start:prod": "NODE_ENV=production next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed-from-json.mjs",
    "db:setup": "npm run migrate && npm run db:seed",
    "clean": "rm -rf .next tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.1.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.6",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
