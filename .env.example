# Public site URL (SEO / canonical)
NEXT_PUBLIC_SITE_URL=https://avemariabeautylab.com

# PostgreSQL (required)
# Local example:
# DATABASE_URL=postgresql://localhost:5432/ave_maria
# Hosted example (Neon / Railway / etc):
# DATABASE_URL=postgresql://user:pass@host:5432/ave_maria?sslmode=require
DATABASE_URL=postgresql://localhost:5432/ave_maria

# Admin panel (/admin) — required for login
ADMIN_USER=admin
ADMIN_PASS=change-me

# Telegram order notifications (optional — orders still accept without these)
BOT_TOKEN=
CHAT_ID=

# Monobank (optional fallback — краще задати в Адмінка → Налаштування → Оплата)
# MONO_TOKEN=
# PREPAY_AMOUNT_UAH=300
# Домен сайту для webhook: NEXT_PUBLIC_SITE_URL або поле «URL сайту» в налаштуваннях

# Nova Poshta (optional — address autocomplete works without a key;
# add a personal key from my.novaposhta.ua to raise API limits)
NOVA_POSHTA_API_KEY=
NEXT_PUBLIC_NOVA_POSHTA_API_KEY=
